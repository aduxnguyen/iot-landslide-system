# ==============================================================
# IoT Landslide Early Warning System - Environment Configuration
# ==============================================================

# Server & Network Ports
PORT=5000
NODE_ENV=production

# JWT Authentication
# LƯU Ý BẢO MẬT: BẮT BUỘC thay đổi JWT_SECRET thành chuỗi ngẫu nhiên dài ít nhất 32 ký tự!
# Hệ thống sẽ TỪ CHỐI KHỞI ĐỘNG nếu phát hiện secret mặc định hoặc quá ngắn!
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_32_CHARS_MIN
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# MQTT Broker Configuration
MQTT_HOST=mosquitto
MQTT_PORT=1883
MQTT_USER=iot_user
MQTT_PASSWORD=iot_secure_pass2026
MQTT_CLIENT_ID=landslide_backend_server

# Initial Admin & Viewer Credentials (khởi tạo lần đầu)
# Hệ thống sẽ tự động băm mật khẩu bằng bcrypt khi seed DB
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=AdminSecurePassword@2026!
INITIAL_VIEWER_USERNAME=viewer
INITIAL_VIEWER_PASSWORD=ViewerGuestPass@2026!

# Database Path
DB_PATH=/app/data/landslide.db

# Telemetry Data Retention (ngày)
DATA_RETENTION_DAYS=30

# CORS / Origin
CORS_ORIGIN=*
